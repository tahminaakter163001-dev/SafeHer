<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FA"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="600dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="28dp"
        android:paddingBottom="22dp">

        <!-- Brand Logo -->
        <ImageView
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:src="@mipmap/safeher_logo"
            android:scaleType="fitCenter"
            android:contentDescription="SafeHer Logo" />

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="SafeHer"
            android:textColor="#8E3155"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- Brand Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="YOUR PERSONAL SAFETY COMPANION"
            android:textColor="#A46B85"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <!-- Welcome Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:text="Your Safety Matters."
            android:textColor="#54243B"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="We're Here for You."
            android:textColor="#8E3155"
            android:textSize="27sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="Stay connected, stay protected. Your personal safety companion, wherever life takes you."
            android:textColor="#725665"
            android:textSize="15sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- Feature Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR SAFETY, ONE TAP AWAY"
                android:textColor="#8E3155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="🆘   Emergency SOS"
                android:textColor="#49343F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="📍   Live Location Sharing"
                android:textColor="#49343F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="🤝   Trusted Emergency Contacts"
                android:textColor="#49343F"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Get Started Button -->
        <Button
            android:id="@+id/getStartedButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#8E3155"
            android:text="Get Started"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Because your safety always comes first. ♡"
            android:textColor="#A46B85"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
