<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="#8E3155"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Keep your personal information up to date"
            android:textColor="#725665"
            android:textSize="15sp"/>

        <!-- Full Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Full Name"
            android:textColor="#33232B"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/editNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#8E3155"
            android:hint="Enter your full name"
            android:inputType="textCapWords|textPersonName"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="#33232B"
            android:textColorHint="#9A8790"/>

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Email Address"
            android:textColor="#33232B"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/editEmailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#8E3155"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="#33232B"
            android:textColorHint="#9A8790"/>

        <!-- Phone Number -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Phone Number"
            android:textColor="#33232B"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/editPhoneInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#8E3155"
            android:hint="Enter your phone number"
            android:inputType="phone"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="#33232B"
            android:textColorHint="#9A8790"/>

        <!-- Address -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Address"
            android:textColor="#33232B"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/editAddressInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#8E3155"
            android:hint="Enter your address"
            android:inputType="textCapSentences|textPostalAddress"
            android:minLines="2"
            android:gravity="top"
            android:padding="14dp"
            android:textColor="#33232B"
            android:textColorHint="#9A8790"/>

        <!-- Date of Birth -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Date of Birth"
            android:textColor="#33232B"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/editDobInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#8E3155"
            android:hint="YYYY-MM-DD"
            android:inputType="date"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="#33232B"
            android:textColorHint="#9A8790"/>

        <!-- Blood Group -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Blood Group"
            android:textColor="#33232B"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/editBloodGroupInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#8E3155"
            android:hint="Example: A+, B+, O-"
            android:inputType="textCapCharacters"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="#33232B"
            android:textColorHint="#9A8790"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/saveProfileButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#8E3155"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"/>

        <!-- Cancel Button -->
        <Button
            android:id="@+id/cancelEditButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#E7D5DE"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#6F2947"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</ScrollView>
