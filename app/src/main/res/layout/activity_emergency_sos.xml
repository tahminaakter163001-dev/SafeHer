<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FA"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="12dp">

    <ScrollView
        android:id="@+id/sosMainScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sendSOSButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sosTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Emergency Assistance"
                android:textColor="#8E3155"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sosDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Your safety matters. Choose trusted people who can help you in an emergency."
                android:textColor="#725665"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/sosMessageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="YOUR EMERGENCY MESSAGE"
                        android:textColor="#8E3155"
                        android:textSize="13sp"
                        android:letterSpacing="0.06"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sosMessagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Your personalized emergency message will appear here."
                        android:textColor="#33232B"
                        android:textSize="14sp"
                        android:lineSpacingExtra="5dp"
                        android:textIsSelectable="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="The message will open in your SMS app. You can review it before sending."
                        android:textColor="#8A7580"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/sosStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#FCE7F3"
                android:padding="14dp"
                android:text="SOS is inactive. You are in control."
                android:textColor="#8E3155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/sosContactsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose trusted contacts"
                        android:textColor="#33232B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sosContactsHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Select the people you want to notify."
                        android:textColor="#725665"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:background="#F0E3E9" />

                    <LinearLayout
                        android:id="@+id/sosContactsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:text="Please make sure your selected contacts are correct before preparing the alert."
                android:textColor="#8A7580"
                android:textSize="12sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/sendSOSButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#D32F2F"
        android:text="SEND SOS ALERT"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toTopOf="@id/sosBackButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/sosBackButton"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:backgroundTint="#8E3155"
        android:text="Back to Dashboard"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textAllCaps="false"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
