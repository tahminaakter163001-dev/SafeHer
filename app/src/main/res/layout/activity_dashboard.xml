<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FA"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- SafeHer Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@mipmap/safeher_logo"
                android:contentDescription="SafeHer Logo"
                android:scaleType="fitCenter"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/dashboardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SafeHer"
                    android:textColor="#8E3155"
                    android:textSize="26sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/welcomeMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Your safety. Our priority."
                    android:textColor="#806775"
                    android:textSize="13sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Emergency SOS Heading -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Always here for you"
            android:textColor="#8E3155"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <!-- SOS Card -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#B32645"
            app:cardCornerRadius="24dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sosButton"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:text="ACTIVATE SOS"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:backgroundTint="#B32645"
                    app:cornerRadius="18dp"
                    app:icon="@android:drawable/ic_dialog_alert"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"
                    app:iconSize="28dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Quick Access Heading -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Your Safety Tools"
            android:textColor="#33232B"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Everything you need, in one place."
            android:textColor="#806775"
            android:textSize="13sp"/>

        <!-- First Row -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/safetyTipsButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Safety Tips"
                    android:textColor="#8E3155"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:backgroundTint="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_menu_info_details"
                    app:iconTint="#8E3155"
                    app:iconGravity="top"
                    app:iconSize="28dp"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profileButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="My Profile"
                    android:textColor="#8E3155"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:backgroundTint="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_menu_myplaces"
                    app:iconTint="#8E3155"
                    app:iconGravity="top"
                    app:iconSize="28dp"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Second Row -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emergencyContactsButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Trusted Contacts"
                    android:textColor="#8E3155"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:backgroundTint="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_menu_call"
                    app:iconTint="#8E3155"
                    app:iconGravity="top"
                    app:iconSize="28dp"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nearbyServicesButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Nearby Services"
                    android:textColor="#8E3155"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:backgroundTint="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_dialog_map"
                    app:iconTint="#8E3155"
                    app:iconGravity="top"
                    app:iconSize="28dp"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Logout -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:text="Logout"
            android:textColor="#8E3155"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:backgroundTint="#F0DCE5"
            app:cornerRadius="14dp"/>

    </LinearLayout>

</ScrollView>
